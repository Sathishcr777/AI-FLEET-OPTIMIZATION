# ==========================================
# FleetIQ Configuration - Environment Variables
# ==========================================

# Application Settings
PROJECT_NAME="FleetIQ - AI Fleet Intelligence"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT=development

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# PostgreSQL + TimescaleDB Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetiq_db
POSTGRES_USER=fleetiq_user
POSTGRES_PASSWORD=fleetiq_password
DATABASE_URL=postgresql+asyncpg://fleetiq_user:fleetiq_password@localhost:5432/fleetiq_db
SYNC_DATABASE_URL=postgresql://fleetiq_user:fleetiq_password@localhost:5432/fleetiq_db

# MQTT Mosquitto Broker Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID=fleetiq_backend_ingest
MQTT_TELEMETRY_TOPIC=fleetiq/telemetry/#
MQTT_ALERTS_TOPIC=fleetiq/alerts/#

# Telemetry Ingestion & Simulator Settings
SIMULATOR_NUM_VEHICLES=5
SIMULATOR_UPDATE_INTERVAL_SEC=1.0
ANOMALY_CONFIDENCE_THRESHOLD=0.75
MAINTENANCE_RISK_HIGH_THRESHOLD=0.70
